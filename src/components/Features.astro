---
const features = [
  {
    title: 'Nutrição Bovina',
    description: 'Fórmulas desenvolvidas para ganho de peso acelerado e saúde animal.',
    icon: '🐄'
  },
  {
    title: 'Acompanhamento',
    description: 'Equipe técnica especializada direto na sua fazenda.',
    icon: '👨‍🌾'
  },
  {
    title: 'Alta Performance',
    description: 'Resultados comprovados no cocho e no balanço final.',
    icon: '📈'
  },
  {
    title: 'Logística Ágil',
    description: 'Entrega rápida para que sua produção nunca pare.',
    icon: '🚚'
  }
];
---
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center animate-fade-in-up">
      <h2 class="text-3xl font-outfit font-bold text-harpia-dark sm:text-4xl">Nossos Serviços</h2>
      <p class="mt-4 text-lg text-gray-600">Entregamos soluções completas para o pecuarista moderno.</p>
    </div>
    
    <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((feature, index) => (
        <div class={`bg-harpia-green text-white p-6 rounded-2xl shadow-xl hover:-translate-y-2 transition-transform duration-300 animate-fade-in-up delay-${(index + 1) * 100}`}>
          <div class="text-4xl mb-4">{feature.icon}</div>
          <h3 class="text-xl font-bold font-outfit mb-2">{feature.title}</h3>
          <p class="text-harpia-lightGreen text-sm opacity-90">{feature.description}</p>
          <a href="#" class="mt-4 inline-flex items-center text-sm font-semibold text-harpia-gold hover:text-white transition-colors">
            Saiba Mais <span aria-hidden="true" class="ml-1">&rarr;</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
