---
<section class="py-24 bg-harpia-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-4xl lg:text-5xl font-playfair font-bold text-white mb-4">Serviços que Oferecemos</h2>
      <p class="text-harpia-light/70 max-w-2xl mx-auto">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service, i) => (
        <div class="bg-harpia-card rounded-2xl p-8 border border-white/5 hover:bg-harpia-green/20 transition-colors group">
          <div class="text-harpia-gold mb-6 opacity-80 group-hover:opacity-100 transition-opacity" set:html={service.icon} />
          <h3 class="text-xl font-playfair font-bold text-white mb-3 text-center">{service.title}</h3>
          <p class="text-harpia-light/60 text-sm text-center leading-relaxed mb-6">
            {service.desc}
          </p>
          <div class="text-center">
            <a href="#" class="text-xs font-semibold text-white/80 hover:text-white uppercase tracking-wider inline-flex items-center gap-1">
              Saiba Mais <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
