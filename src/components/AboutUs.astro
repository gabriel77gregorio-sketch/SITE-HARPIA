---
---
<section class="py-24 relative z-10 bg-gradient-to-b from-transparent via-harpia-bg/95 to-harpia-bg backdrop-blur-md border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      
      <!-- Imagem Flutuante -->
      <div class="relative animate-fade-in-up order-2 lg:order-1">
        <div class="relative w-full max-w-md mx-auto transform hover:scale-105 transition-transform duration-500">
          <!-- Glow background -->
          <div class="absolute -inset-4 bg-harpia-gold/20 blur-2xl rounded-full opacity-50 animate-[pulse_4s_ease-in-out_infinite]"></div>
          <!-- Imagem com animação CSS flutuante -->
          <img src="/desde%202016.jpg" alt="Desde 2016" class="relative rounded-[2rem] object-cover h-[500px] w-full shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 animate-[float_6s_ease-in-out_infinite]" style="animation: float 6s ease-in-out infinite;" />
        </div>
      </div>

      <!-- Textos e Trilha -->
      <div class="animate-fade-in-up order-1 lg:order-2">
        <h2 class="text-4xl lg:text-5xl font-playfair font-bold text-white leading-tight mb-6">
          Tradição, Tecnologia e Respeito pelo Produtor.
        </h2>
        <p class="text-harpia-light/80 font-inter mb-6 leading-relaxed">
          Desde 2016, sediada em Santo Antônio do Jardim - SP, a Harpia Nutrição Animal atua no mercado com um propósito claro: produzir e comercializar alimentos de altíssima qualidade e valor agregado para a pecuária nacional.
        </p>
        <p class="text-harpia-light/80 font-inter mb-10 leading-relaxed">
          Acreditamos que a segurança alimentar e a conversão de nutrientes começam na seleção rígida de matérias-primas. Contamos com um parque industrial moderno, processos automatizados e equipe técnica especializada para garantir que cada saca entregue no seu galpão atenda às exigências zootécnicas mais rigorosas do mercado.
        </p>
        
        <!-- Timeline Trilha -->
        <div id="trilha-container" class="relative pl-8 border-l-2 border-white/10 space-y-8 py-4">
          <!-- Linha animada que desce com o scroll -->
          <div id="trilha-progress" class="absolute top-0 left-[-2px] w-[2px] bg-gradient-to-b from-harpia-gold to-yellow-300 h-0 transition-all duration-150 ease-out shadow-[0_0_10px_#e6c875]"></div>
          
          <div class="relative group">
            <div class="absolute -left-[39px] top-6 w-3 h-3 rounded-full bg-harpia-card border-2 border-white/20 group-hover:border-harpia-gold transition-colors duration-300 z-10 trilha-dot"></div>
            <div class="bg-harpia-card p-6 rounded-2xl border border-white/5 hover:border-harpia-gold/30 transition-all shadow-lg hover:shadow-harpia-gold/10">
              <h4 class="text-harpia-gold font-playfair font-bold text-xl mb-2 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> Missão
              </h4>
              <p class="text-sm text-harpia-light/80 leading-relaxed">Produzir e comercializar nutrição animal de excelência, receber e armazenar grãos com total segurança e dar o suporte necessário para que os animais de sua criação atinjam o ápice do potencial genético com responsabilidade socioambiental.</p>
            </div>
          </div>
          
          <div class="relative group">
            <div class="absolute -left-[39px] top-6 w-3 h-3 rounded-full bg-harpia-card border-2 border-white/20 group-hover:border-harpia-gold transition-colors duration-300 z-10 trilha-dot"></div>
            <div class="bg-harpia-card p-6 rounded-2xl border border-white/5 hover:border-harpia-gold/30 transition-all shadow-lg hover:shadow-harpia-gold/10">
              <h4 class="text-harpia-gold font-playfair font-bold text-xl mb-2 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg> Visão
              </h4>
              <p class="text-sm text-harpia-light/80 leading-relaxed">Ser reconhecidos pelo produtor regional como a principal referência em confiabilidade, inovação nutricional e transparência comercial.</p>
            </div>
          </div>

          <div class="relative group">
            <div class="absolute -left-[39px] top-6 w-3 h-3 rounded-full bg-harpia-card border-2 border-white/20 group-hover:border-harpia-gold transition-colors duration-300 z-10 trilha-dot"></div>
            <div class="bg-harpia-card p-6 rounded-2xl border border-white/5 hover:border-harpia-gold/30 transition-all shadow-lg hover:shadow-harpia-gold/10">
              <h4 class="text-harpia-gold font-playfair font-bold text-xl mb-2 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg> Valores
              </h4>
              <p class="text-sm text-harpia-light/80 leading-relaxed">Espírito de equipe, total respeito pelas pessoas, transparência nos negócios, foco absoluto no sucesso do cliente e compromisso com o desenvolvimento sustentável do campo.</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }
</style>

<script>
  // Lógica da trilha de rolagem
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('trilha-container');
    const progressLine = document.getElementById('trilha-progress');
    const dots = document.querySelectorAll('.trilha-dot');

    if (!container || !progressLine) return;

    const handleScroll = () => {
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      // O quão longe o topo do container está do centro da tela (offset)
      // Ajuste o offset para começar a encher a linha quando o container entra no meio da tela
      const scrollStart = windowHeight * 0.7; 
      
      if (rect.top < scrollStart) {
        // Calcula a porcentagem percorrida
        let percentage = ((scrollStart - rect.top) / rect.height) * 100;
        
        // Limita entre 0 e 100%
        percentage = Math.max(0, Math.min(percentage, 100));
        
        progressLine.style.height = `${percentage}%`;

        // Acender as bolinhas conforme a linha passa por elas
        dots.forEach((dot, index) => {
          // As bolinhas estão distribuídas pela altura do container
          // Estimando a posição: bolinha 1 = ~10%, bolinha 2 = ~50%, bolinha 3 = ~90%
          const dotThreshold = (index * 40) + 10; 
          
          if (percentage > dotThreshold) {
            dot.classList.remove('bg-harpia-card', 'border-white/20');
            dot.classList.add('bg-harpia-gold', 'border-harpia-gold', 'shadow-[0_0_10px_#e6c875]');
          } else {
            dot.classList.add('bg-harpia-card', 'border-white/20');
            dot.classList.remove('bg-harpia-gold', 'border-harpia-gold', 'shadow-[0_0_10px_#e6c875]');
          }
        });

      } else {
        progressLine.style.height = '0%';
        dots.forEach(dot => {
          dot.classList.add('bg-harpia-card', 'border-white/20');
          dot.classList.remove('bg-harpia-gold', 'border-harpia-gold', 'shadow-[0_0_10px_#e6c875]');
        });
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Chama uma vez para verificar estado inicial
    handleScroll();
  });
</script>
