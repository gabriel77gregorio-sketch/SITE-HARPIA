<header class="fixed w-full top-0 z-[60] py-3 lg:py-4 transition-all duration-300" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-full flex justify-between items-center py-2 px-4 lg:py-2.5 lg:px-6 relative z-50">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img src="/logo-oficial.png" alt="Logo Harpia" class="h-8 lg:h-10 w-auto object-contain" />
      </a>
      
      <!-- Desktop Nav -->
      <nav class="hidden md:flex gap-8 font-inter text-sm font-medium text-harpia-light">
