        <a href="https://wa.me/556230000000?text=Ol%C3%A1%21+Gostaria+de+falar+com+um+especialista+da+Harpia." target="_blank" class="hidden sm:flex bg-harpia-gold text-harpia-bg font-semibold px-6 py-2.5 rounded-full hover:bg-yellow-500 transition-all text-sm items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          Técnico
        </a>
        
        <!-- Mobile Menu Button -->
        <button id="mobile-menu-button" class="md:hidden text-white p-2 focus:outline-none hover:text-harpia-gold transition-colors" aria-label="Abrir Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-harpia-card/95 backdrop-blur-xl border border-white/10 rounded-2xl mt-2 overflow-hidden relative z-40 transform origin-top transition-all shadow-2xl">
      <nav class="flex flex-col py-6 px-6 gap-6 font-inter text-base font-medium text-white">
        <a href="/" class="hover:text-harpia-gold transition-colors flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-harpia-gold"></div> Início</a>
        <a href="/racoes" class="hover:text-harpia-gold transition-colors flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-harpia-gold"></div> Linhas de Rações</a>
        <a href="/insumos" class="hover:text-harpia-gold transition-colors flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-harpia-gold"></div> Insumos a Granel</a>
        <a href="/#armazenagem" class="hover:text-harpia-gold transition-colors flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-harpia-gold"></div> Armazenagem</a>
        <div class="h-px w-full bg-white/10 my-2"></div>
        <a href="https://wa.me/556230000000?text=Ol%C3%A1%21+Gostaria+de+falar+com+um+especialista+da+Harpia." class="flex items-center justify-center gap-2 bg-harpia-gold text-harpia-bg font-semibold px-4 py-3 rounded-full">
           Falar com Especialista Técnico
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Simple script to toggle mobile menu visibility
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  });
</script>
