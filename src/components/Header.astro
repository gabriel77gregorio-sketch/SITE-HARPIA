---
---
<header class="fixed w-full top-0 z-[60] py-3 lg:py-4 transition-all duration-300" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white/90 backdrop-blur-md border border-slate-200/85 shadow-sm rounded-full flex justify-between items-center py-2 px-4 lg:py-2.5 lg:px-6 relative z-50">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img src="/logo-oficial.png" alt="Logo Harpia" class="h-8 lg:h-10 w-auto object-contain" />
      </a>
      
      <!-- Desktop Nav -->
      <nav class="hidden md:flex gap-8 font-inter text-sm font-medium text-harpia-light">
        <a href="/" class="hover:text-harpia-gold transition-colors">Início</a>
        <a href="/racoes" class="hover:text-harpia-gold transition-colors">Linhas de Rações</a>
        <a href="/insumos" class="hover:text-harpia-gold transition-colors">Insumos a Granel</a>
        <a href="/#armazenagem" class="hover:text-harpia-gold transition-colors">Armazenagem</a>
      </nav>

      <!-- Mobile Toggle Button (Cor Escura) -->
      <div class="flex items-center md:hidden shrink-0">
        <button id="mobile-menu-button" class="text-slate-800 p-2 focus:outline-none hover:text-harpia-gold transition-colors" aria-label="Abrir Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav Menu (Verde Harpia com texto branco) -->
    <div id="mobile-menu" class="hidden md:hidden bg-harpia-green backdrop-blur-xl border border-emerald-700/50 rounded-2xl mt-2 overflow-hidden relative z-40 transform origin-top transition-all shadow-2xl">
      <nav class="flex flex-col py-6 px-6 gap-6 font-inter text-base font-semibold text-white">
        <a href="/" class="hover:text-harpia-gold transition-colors flex items-center gap-2.5"><div class="w-2 h-2 rounded-full bg-harpia-gold"></div> Início</a>
        <a href="/racoes" class="hover:text-harpia-gold transition-colors flex items-center gap-2.5"><div class="w-2 h-2 rounded-full bg-harpia-gold"></div> Linhas de Rações</a>
        <a href="/insumos" class="hover:text-harpia-gold transition-colors flex items-center gap-2.5"><div class="w-2 h-2 rounded-full bg-harpia-gold"></div> Insumos a Granel</a>
        <a href="/#armazenagem" class="hover:text-harpia-gold transition-colors flex items-center gap-2.5"><div class="w-2 h-2 rounded-full bg-harpia-gold"></div> Armazenagem</a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Simple script to toggle mobile menu visibility
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  });
</script>
