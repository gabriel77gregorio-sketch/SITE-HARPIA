---
---
<!-- Fundo Parallax Fixo -->
<div class="fixed top-0 left-0 w-full h-screen -z-20 pointer-events-none">
  <div class="absolute inset-0 bg-[url('/imagem-hero.png')] bg-cover bg-center opacity-20 transform scale-105 animate-[pulse_20s_ease-in-out_infinite_alternate]"></div>
  <div class="absolute inset-0 bg-gradient-to-tr from-harpia-bg via-harpia-bg/90 to-transparent"></div>
</div>

<section class="relative lg:min-h-screen flex items-start lg:items-center justify-center pt-6 pb-20 lg:pt-0 lg:pb-0">
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10 grid lg:grid-cols-12 gap-8 lg:gap-16 items-start lg:items-center md:-mt-24">
    
    <!-- Coluna Esquerda: Textos -->
    <div class="lg:col-span-7 animate-fade-in-up flex flex-col items-center lg:items-start text-center lg:text-left">
      <div class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full bg-white/60 lg:bg-slate-100 border border-slate-200 backdrop-blur-md mb-4 sm:mb-6 shadow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-harpia-green opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-harpia-green"></span>
        </span>
        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-harpia-green">Tecnologia Agro 2026</span>
      </div>

      <h1 class="text-4xl leading-[1.15] sm:text-5xl lg:text-6xl font-playfair font-bold text-harpia-dark tracking-tight">
        Nutrição de <br class="hidden sm:block lg:hidden" />Alta Performance que se Traduz em <br/>
        <span class="text-harpia-gold italic relative inline-block mt-2 sm:mt-3">
          Lucro na Balança.
          <svg class="absolute -bottom-1 sm:-bottom-2 left-0 w-full h-1.5 sm:h-2 text-harpia-gold/60" viewBox="0 0 100 10" preserveAspectRatio="none">
            <path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="3" fill="none"/>
          </svg>
        </span>
      </h1>
      
      <p class="mt-5 sm:mt-8 text-base sm:text-lg text-harpia-muted font-inter max-w-xl leading-relaxed lg:border-l-2 lg:border-harpia-gold/30 lg:pl-4 mx-auto lg:mx-0">
        Da fábrica ao cocho, fornecemos rações completas, suplementos avançados, insumos selecionados e serviços de armazenagem de grãos para quem busca a <strong class="text-harpia-green font-bold">máxima eficiência produtiva</strong>.
      </p>
      
      <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 items-center w-full lg:w-auto px-4 lg:px-0">
        <a href="https://wa.me/556230000000?text=Ol%C3%A1%21+Gostaria+de+falar+com+um+consultor+de+vendas." target="_blank" class="group relative inline-flex justify-center items-center px-6 py-4 sm:px-8 bg-harpia-green text-white text-sm sm:text-base font-bold rounded-full overflow-hidden transition-all shadow-[0_8px_30px_rgba(16,96,55,0.3)] hover:shadow-[0_12px_40px_rgba(16,96,55,0.5)] hover:-translate-y-1 w-full sm:w-auto">
          <span class="absolute inset-0 bg-gradient-to-r from-emerald-600 to-harpia-green opacity-0 group-hover:opacity-100 transition-opacity"></span>
          <span class="relative z-10 flex items-center gap-2">
            Falar com Especialista
            <svg class="w-4 h-4 sm:w-5 sm:h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </span>
        </a>
        <a href="/racoes" class="inline-flex justify-center items-center px-6 py-4 sm:px-8 border border-slate-200/80 rounded-full text-slate-700 bg-white/70 hover:bg-white hover:text-harpia-dark text-sm sm:text-base font-bold transition-all backdrop-blur-xl shadow-sm w-full sm:w-auto">
          Catálogo Digital
        </a>
      </div>
    </div>

    <!-- Coluna Direita: Elementos Glassmorphism (2026 Feel) -->
    <div class="lg:col-span-5 flex flex-col gap-4 sm:gap-6 relative mt-12 lg:mt-0 px-2 sm:px-0">
      <!-- Glow effect de fundo -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 sm:w-64 sm:h-64 bg-harpia-green/15 blur-[60px] sm:blur-[80px] rounded-full pointer-events-none"></div>
      
      <!-- Card Superior: Desempenho -->
      <div class="bg-gradient-to-br from-white/95 to-slate-50/90 backdrop-blur-xl border border-slate-200/80 p-5 sm:p-6 rounded-2xl sm:rounded-3xl shadow-xl relative lg:translate-x-4 hover:-translate-y-1 transition-transform">
        <div class="flex justify-between items-start mb-3 sm:mb-4">
          <div class="bg-harpia-green/10 text-harpia-green text-[10px] sm:text-xs px-2.5 py-1 sm:px-3 rounded-full font-bold uppercase tracking-wide">
            Resultado Comprovado
          </div>
          <div class="flex text-harpia-gold gap-0.5 text-[10px] sm:text-xs">
            ★★★★★
          </div>
        </div>
        <h3 class="text-3xl sm:text-4xl font-playfair font-bold text-harpia-green mb-1">+7,01 @</h3>
        <p class="text-xs sm:text-sm text-harpia-muted font-inter mb-3 sm:mb-4">Ganho líquido por animal em 72 dias</p>
        
        <!-- Grafico simulado -->
        <div class="flex items-end gap-1.5 sm:gap-2 h-10 sm:h-12 mt-2">
          <div class="w-1/5 bg-harpia-green/10 rounded-t-sm h-1/4"></div>
          <div class="w-1/5 bg-harpia-green/20 rounded-t-sm h-2/4"></div>
          <div class="w-1/5 bg-harpia-green/35 rounded-t-sm h-3/4"></div>
          <div class="w-1/5 bg-harpia-gold/60 rounded-t-sm h-4/5"></div>
          <div class="w-1/5 bg-harpia-gold rounded-t-sm h-full relative group">
            <div class="absolute -top-1.5 sm:-top-2 -right-1 sm:-right-1.5 w-2.5 h-2.5 sm:w-3 sm:h-3 bg-white border-2 border-harpia-gold rounded-full shadow-md"></div>
            <div class="absolute -top-1.5 sm:-top-2 -right-1 sm:-right-1.5 w-2.5 h-2.5 sm:w-3 sm:h-3 bg-harpia-gold rounded-full animate-ping opacity-75"></div>
          </div>
        </div>
      </div>

      <!-- Card Inferior: Confiança -->
      <div class="bg-white/95 backdrop-blur-xl border border-slate-200/80 p-4 sm:p-5 rounded-2xl sm:rounded-3xl shadow-lg flex items-center gap-3 sm:gap-4 lg:-translate-x-4 hover:-translate-y-1 transition-transform">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-harpia-green/10 flex items-center justify-center shrink-0 border border-harpia-green/20">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-harpia-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <div>
          <p class="text-slate-800 font-bold font-inter text-xs sm:text-sm">Qualidade de Origem</p>
          <p class="text-[10px] sm:text-xs text-harpia-muted mt-0.5">Matérias-primas rigorosamente selecionadas.</p>
        </div>
      </div>
    </div>
    
  </div>
</section>
