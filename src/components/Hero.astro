---
---
<!-- Fundo Parallax Fixo -->
<div class="fixed top-0 left-0 w-full h-screen -z-20 pointer-events-none">
  <div class="absolute inset-0 bg-[url('/imagem-hero.png')] bg-cover bg-center opacity-30 transform scale-105 animate-[pulse_20s_ease-in-out_infinite_alternate]"></div>
  <div class="absolute inset-0 bg-gradient-to-tr from-harpia-bg via-harpia-bg/80 to-transparent"></div>
</div>

<section class="relative lg:min-h-screen flex items-start lg:items-center justify-center pt-6 pb-20 lg:pt-0 lg:pb-0">
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10 grid lg:grid-cols-12 gap-8 lg:gap-16 items-start lg:items-center md:-mt-24">
    
    <!-- Coluna Esquerda: Textos -->
    <div class="lg:col-span-7 animate-fade-in-up">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-3 sm:mb-4">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-harpia-gold opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-harpia-gold"></span>
        </span>
        <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-harpia-light">Tecnologia Agro 2026</span>
      </div>

      <h1 class="text-[32px] leading-[1.1] sm:text-5xl lg:text-6xl font-playfair font-bold text-white sm:leading-[1.1] tracking-tight">
        Nutrição de <br class="hidden sm:block" />Alta Performance que se Traduz em <br/>
        <span class="text-harpia-gold italic relative inline-block mt-1 sm:mt-2">
          Lucro na Balança.
          <svg class="absolute -bottom-1 sm:-bottom-2 left-0 w-full h-1 sm:h-2 text-harpia-gold/60" viewBox="0 0 100 10" preserveAspectRatio="none">
            <path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="3" fill="none"/>
          </svg>
        </span>
      </h1>
      
      <p class="mt-4 sm:mt-8 text-base sm:text-lg text-harpia-light/80 font-inter max-w-xl leading-relaxed border-l-2 border-harpia-gold/30 pl-3 sm:pl-4">
        Da fábrica ao cocho, fornecemos rações completas, suplementos avançados, insumos selecionados e serviços de armazenagem de grãos para quem busca a <strong class="text-white">máxima eficiência produtiva</strong>.
      </p>
      
      <div class="mt-6 sm:mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-center">
        <a href="https://wa.me/556230000000?text=Ol%C3%A1%21+Gostaria+de+falar+com+um+consultor+de+vendas." target="_blank" class="group relative inline-flex justify-center items-center px-6 py-3.5 sm:px-8 sm:py-4 bg-harpia-gold text-harpia-bg text-sm sm:text-base font-bold rounded-full overflow-hidden transition-all shadow-[0_0_20px_rgba(230,200,117,0.3)] hover:shadow-[0_0_30px_rgba(230,200,117,0.5)] hover:-translate-y-0.5">
          <span class="relative z-10 flex items-center gap-2">
            Falar com Especialista
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </span>
        </a>
        <a href="/racoes" class="inline-flex justify-center items-center px-6 py-3.5 sm:px-8 sm:py-4 border border-white/10 rounded-full text-white bg-white/5 hover:bg-white/10 text-sm sm:text-base font-medium transition-all backdrop-blur-md">
          Catálogo Digital
        </a>
      </div>
    </div>

    <!-- Coluna Direita: Elementos Glassmorphism (2026 Feel) -->
    <div class="lg:col-span-5 hidden lg:flex flex-col gap-6 relative">
      <!-- Glow effect de fundo -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-harpia-green/40 blur-[80px] rounded-full pointer-events-none"></div>
      
      <!-- Card Superior: Desempenho -->
      <div class="bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-xl border border-white/10 p-6 rounded-3xl shadow-2xl relative translate-x-4">
        <div class="flex justify-between items-start mb-4">
          <div class="bg-harpia-gold/20 text-harpia-gold text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wide">
            Resultado Comprovado
          </div>
          <div class="flex text-harpia-gold gap-0.5 text-xs">
            ★★★★★
          </div>
        </div>
        <h3 class="text-3xl font-playfair font-bold text-white mb-1">+7,01 @</h3>
        <p class="text-sm text-harpia-light/70 font-inter mb-4">Ganho líquido por animal em 72 dias</p>
        
        <!-- Grafico simulado -->
        <div class="flex items-end gap-2 h-12 mt-2">
          <div class="w-1/5 bg-white/10 rounded-t-sm h-1/4"></div>
          <div class="w-1/5 bg-white/20 rounded-t-sm h-2/4"></div>
          <div class="w-1/5 bg-white/30 rounded-t-sm h-3/4"></div>
          <div class="w-1/5 bg-harpia-gold/60 rounded-t-sm h-4/5"></div>
          <div class="w-1/5 bg-harpia-gold rounded-t-sm h-full relative">
            <div class="absolute -top-2 -right-1 w-2 h-2 bg-white rounded-full animate-ping"></div>
          </div>
        </div>
      </div>

      <!-- Card Inferior: Confiança -->
      <div class="bg-harpia-card/60 backdrop-blur-md border border-white/5 p-5 rounded-3xl shadow-xl flex items-center gap-4 -translate-x-4">
        <div class="w-12 h-12 rounded-full bg-harpia-green/30 flex items-center justify-center shrink-0 border border-harpia-green/50">
          <svg class="w-6 h-6 text-harpia-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <div>
          <p class="text-white font-bold font-inter text-sm">Qualidade de Origem</p>
          <p class="text-xs text-harpia-light/60 mt-0.5">Matérias-primas rigorosamente selecionadas.</p>
        </div>
      </div>
    </div>
    
  </div>
</section>
