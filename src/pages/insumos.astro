---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const insumos = [
  { item: "Milho em Grão", sacaria: "Sacos de 25 kg e 50 kg" },
  { item: "Quirera (Fina e Grossa)", sacaria: "Sacos de 25 kg e 50 kg" },
  { item: "Quirera Peneirada (Fina, Média, Grossa)", sacaria: "Sacos de 25 kg" },
  { item: "Quirera Gritz", sacaria: "Sacos de 25 kg" },
  { item: "Farelo de Soja", sacaria: "Sacos de 50 kg" },
  { item: "Farelo de Soja Semi-Integral", sacaria: "Sacos de 50 kg" },
  { item: "Farelo de Trigo", sacaria: "Sacos de 40 kg" },
  { item: "Farelo de Algodão 38%", sacaria: "Sacos de 50 kg" },
  { item: "Farelo de Arroz", sacaria: "Sacos de 40 kg" },
  { item: "Farelo de Milho (DDG's)", sacaria: "Sacos de 40 kg" },
  { item: "Farelo de Amendoim", sacaria: "Sacos de 50 kg" },
  { item: "Aveia em Casca", sacaria: "Sacos de 40 kg" },
  { item: "Sorgo em Grão", sacaria: "Sacos de 50 kg" },
  { item: "Sorgo Moído", sacaria: "Sacos de 50 kg" },
  { item: "Caroço de Algodão", sacaria: "Sacos de 40 kg" },
  { item: "Polpa Cítrica Peletizada", sacaria: "Sacos de 50 kg" },
  { item: "Polpa Cítrica Moída", sacaria: "Sacos de 50 kg" },
  { item: "Trigo em Grão Moído", sacaria: "Sacos de 40 kg" },
  { item: "Calcário Calcítico", sacaria: "Sacos de 50 kg" },
  { item: "Bicarbonato", sacaria: "Sacos de 25 kg" },
  { item: "Ureia Pecuária", sacaria: "Sacos de 25 kg" },
  { item: "Ureia Protegida", sacaria: "Sacos de 25 kg" },
  { item: "Sal Comum", sacaria: "Sacos de 25 kg" }
];
---

<Layout title="Insumos a Granel - Harpia Nutrição Animal">
  <div class="pt-32 pb-16 bg-harpia-bg border-b border-slate-200/50 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1588666352934-2e970a2f472f?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-harpia-bg to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-fade-in-up z-10">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-playfair font-bold text-harpia-dark mb-6">Insumos a Granel</h1>
      <p class="text-harpia-muted text-base sm:text-lg max-w-3xl mx-auto leading-relaxed">
        Qualidade de Origem para a sua Mistura na Fazenda. Compre com quem entende de nutrição e tem parcerias com os maiores fornecedores do mercado agropecuário nacional.
      </p>
    </div>
  </div>

  <div class="bg-slate-50 py-12 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-2xl sm:rounded-3xl shadow-xl border border-slate-200/85 overflow-hidden animate-fade-in-up">
        <div class="p-5 sm:p-8 border-b border-slate-200/60 bg-white">
          <h2 class="text-xl sm:text-2xl font-playfair font-bold text-harpia-dark flex items-center gap-2 sm:gap-3">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-harpia-green shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Catálogo de Insumos
          </h2>
          <p class="text-harpia-muted mt-2 text-xs sm:text-sm">Oferecemos grãos limpos, farelos moídos na granulometria ideal e minerais puros com entrega rápida diretamente para a sua propriedade.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[300px]">
            <thead>
              <tr class="bg-harpia-green/10 text-harpia-green text-xs sm:text-sm uppercase tracking-wider">
                <th class="py-3 px-4 sm:py-4 sm:px-6 font-semibold">Descrição do Produto</th>
                <th class="py-3 px-4 sm:py-4 sm:px-6 font-semibold">Apresentação</th>
                <th class="py-3 px-4 sm:py-4 sm:px-6 font-semibold text-center hidden md:table-cell">Recomendação</th>
              </tr>
            </thead>
            <tbody class="text-xs sm:text-sm font-inter divide-y divide-slate-200/60">
              {insumos.map((item) => (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-3 px-4 sm:py-4 sm:px-6 text-slate-800 font-medium">{item.item}</td>
                  <td class="py-3 px-4 sm:py-4 sm:px-6 text-slate-600">{item.sacaria}</td>
                  <td class="py-3 px-4 sm:py-4 sm:px-6 text-slate-500 text-center italic hidden md:table-cell">A consultar técnico</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        
        <div class="p-5 sm:p-8 bg-white border-t border-slate-200/60 text-center">
          <a href="https://wa.me/556230000000?text=Ol%C3%A1%21+Gostaria+de+receber+a+cota%C3%A7%C3%A3o+da+semana+para+os+insumos+a+granel+da+Harpia+%28farelo+de+soja%2C+milho+mo%C3%ADdo+e+aditivos%29." target="_blank" class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-harpia-green text-white font-bold px-6 sm:px-10 py-3 sm:py-4 rounded-full hover:bg-emerald-800 transition-all shadow-lg shadow-harpia-green/10 text-sm sm:text-base">
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            Solicitar Cotação da Semana
          </a>
        </div>
      </div>
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          Solicitar Cotação da Semana
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
